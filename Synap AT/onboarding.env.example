PUBLIC_ORIGIN=https://at.synapdome.com
ONBOARDING_HOST=127.0.0.1
ONBOARDING_PORT=4174
# Private persistent directory, outside the served website. One Node process only.
ONBOARDING_DATA_DIR=/var/lib/synapdome/onboarding
# Start with a DocuSign developer account. Live delivery requires production API access.
DS_AUTH_HOST=account-d.docusign.com
DS_BASE_URL=https://demo.docusign.net/restapi
DS_CLIENT_ID=
DS_USER_ID=
DS_ACCOUNT_ID=
DS_TEMPLATE_ID=
DS_SIGNER_ROLE=Customer
DS_PRIVATE_KEY_PATH=/etc/synapdome/docusign-private.pem
DS_CONNECT_SECRET=
