# Render with scripts/render-gateway.py. All routes, including assets, are authenticated.
# Dedicated hostname avoids the application's absolute /assets and API route conflicts.
map $http_upgrade $synap_connection { default upgrade; '' close; }
map "$request_method:$http_origin" $synap_bad_origin {
    default 1;
    ~^(GET|HEAD|OPTIONS): 0;
    "POST:https://${WORKSPACE_HOST}" 0;
    "PUT:https://${WORKSPACE_HOST}" 0;
    "PATCH:https://${WORKSPACE_HOST}" 0;
    "DELETE:https://${WORKSPACE_HOST}" 0;
}
map $http_origin $synap_ws_origin {
    default 0;
    "https://${WORKSPACE_HOST}" 1;
}
server {
    listen 443 ssl;
    server_name ${WORKSPACE_HOST};
    ssl_certificate ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;
    client_max_body_size 100m;

    location = /_synap_auth {
        internal;
        proxy_pass ${AUTH_VERIFY_URL};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location / {
        if ($synap_bad_origin) { return 403; }
        # WebSocket handshakes are GET; independently reject missing/foreign origins.
        set $synap_ws_check "$http_upgrade:$synap_ws_origin";
        if ($synap_ws_check ~* "^websocket:0$") { return 403; }
        auth_request /_synap_auth;
        proxy_pass http://127.0.0.1:4096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "Basic ${ENGINE_BASIC}";
        proxy_set_header Cookie "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $synap_connection;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
