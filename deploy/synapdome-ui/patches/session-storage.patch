+import { afterEach, expect, test } from "bun:test"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { Workspace } from "../../src/session/workspace"
+const previous = process.env.SYNAPDOME_SESSION_ROOT
+const directories: string[] = []
+afterEach(async () => {
+  if (previous === undefined) delete process.env.SYNAPDOME_SESSION_ROOT
+  else process.env.SYNAPDOME_SESSION_ROOT = previous
+  for (const directory of directories.splice(0)) await fs.rm(directory, { recursive: true, force: true })
+})
+test("creates distinct sessions and rejects traversal and symlink escapes", async () => {
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), "synapdome-storage-"))
+  directories.push(temporary)
+  const root = path.join(temporary, "sessions")
+  await fs.mkdir(root)
+  process.env.SYNAPDOME_SESSION_ROOT = root
+  const first = await Workspace.create("ses_first123", "/")
+  const second = await Workspace.create("ses_second123", "/")
+  expect(first).not.toBe(second)
+  expect(await fs.readdir(first)).toEqual(["evidence", "uploads"])
+  expect(Workspace.allowed(path.join(root, "..", "outside"))).toBe(false)
+  await fs.symlink(temporary, path.join(first, "escape"))
+  expect(Workspace.allowed(path.join(first, "escape", "new.txt"))).toBe(false)
+  expect(Workspace.allowed(second, first)).toBe(false)
+  await expect(Workspace.create("../../escape", "/")).rejects.toThrow()
+})
+test("preserves existing behavior without configuration", async () => {
+  delete process.env.SYNAPDOME_SESSION_ROOT
+  expect(await Workspace.create("ses_test", "/existing")).toBe("/existing")
+})
+
+test("named folders are isolated and duplicates and unsafe names are rejected", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "synapdome-names-"))
+  directories.push(root)
+  process.env.SYNAPDOME_SESSION_ROOT = root
+  expect(await Workspace.create("ses_named", "/", "Mobile assessment")).toBe(path.join(root, "Mobile assessment"))
+  await expect(Workspace.create("ses_other", "/", "Mobile assessment")).rejects.toThrow()
+  for (const name of ["../escape", "/tmp/escape", "..", "a/b", "a\\b"]) {
+    await expect(Workspace.create("ses_invalid", "/", name)).rejects.toThrow()
+  }
+})
