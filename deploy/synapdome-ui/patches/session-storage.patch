+import path from "node:path"
+import fs from "node:fs"
+
+/** Operator configuration, never supplied by an HTTP client. */
+export namespace Workspace {
+  export function root() {
+    return process.env.SYNAPDOME_SESSION_ROOT ? path.resolve(process.env.SYNAPDOME_SESSION_ROOT) : undefined
+  }
+
+  export function contains(base: string, target: string) {
+    const relative = path.relative(base, target)
+    return relative === "" || (!relative.startsWith(".." + path.sep) && relative !== ".." && !path.isAbsolute(relative))
+  }
+
+  // Resolve existing ancestors too, so symlinks cannot escape for new files.
+  export function canonical(target: string): string {
+    const resolved = path.resolve(target)
+    try {
+      return fs.realpathSync(resolved)
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
+      const parent = path.dirname(resolved)
+      if (parent === resolved) throw error
+      return path.join(canonical(parent), path.basename(resolved))
+    }
+  }
+
+  export function allowed(target: string, base = root()) {
+    if (!base) return true
+    return contains(canonical(base), canonical(target))
+  }
+
+  export async function create(id: string, fallback: string, folderName?: string) {
+    const base = root()
+    if (!base) return fallback
+    if (!/^ses_[a-zA-Z0-9]+$/.test(id)) throw new Error("Invalid session identifier")
+    const name = folderName?.trim() || id
+    if (!/^[a-zA-Z0-9][a-zA-Z0-9 ._-]{0,79}$/.test(name) || name.endsWith(".")) throw new Error("Use 1–80 letters, numbers, spaces, dots, underscores or hyphens; start with a letter or number")
+    const directory = path.join(base, name)
+    if (!allowed(directory)) throw new Error("Session path escapes configured workspace")
+    await fs.promises.mkdir(base, { recursive: true, mode: 0o700 })
+    await fs.promises.mkdir(directory, { mode: 0o700 })
+    for (const name of ["uploads", "evidence"]) {
+      await fs.promises.mkdir(path.join(directory, name), { recursive: true, mode: 0o700 })
+    }
+    return directory
+  }
+}
