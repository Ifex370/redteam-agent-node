+import { createStore } from "solid-js/store"
+import { Show } from "solid-js"
+import { Dialog } from "@cyberstrike-io/ui/dialog"
+import { Button } from "@cyberstrike-io/ui/button"
+import { TextField } from "@cyberstrike-io/ui/text-field"
+import { useDialog } from "@cyberstrike-io/ui/context/dialog"
+import { useGlobalSDK } from "@/context/global-sdk"
+import { useGlobalSync } from "@/context/global-sync"
+import type { Session } from "@cyberstrike-io/sdk/v2/client"
+
+export function DialogNewSession(props: { directory: string; onCreated: (session: Session) => void }) {
+  const dialog = useDialog()
+  const sdk = useGlobalSDK()
+  const sync = useGlobalSync()
+  const [state, setState] = createStore({ name: "", busy: false, error: "" })
+  async function submit(event: SubmitEvent) {
+    event.preventDefault()
+    if (state.busy) return
+    const name = state.name.trim()
+    if (!/^[a-zA-Z0-9][a-zA-Z0-9 ._-]{0,79}$/.test(name) || name.endsWith(".")) {
+      setState("error", "Enter 1–80 letters, numbers, spaces, dots, underscores or hyphens. Start with a letter or number.")
+      return
+    }
+    setState({ busy: true, error: "" })
+    try {
+      const workspace = await sdk.fetch("/workspace").then((r) => r.json())
+      if (workspace.locked && !workspace.namedFolders) throw new Error("Restart the local SynapDome backend to enable named session folders.")
+      const directory = workspace.locked ? workspace.directory : props.directory
+      const response = await sdk.fetch(`/session?directory=${encodeURIComponent(directory)}`, {
+        method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ title: name, folderName: name }),
+      })
+      if (!response.ok) {
+        const text = await response.text()
+        throw new Error(text.includes("EEXIST") ? "That folder already exists. Choose another name." : "Could not create the session. Please try again.")
+      }
+      const session: Session = await response.json()
+      await sync.project.loadSessions(directory)
+      dialog.close()
+      props.onCreated(session)
+    } catch (error) {
+      setState("error", error instanceof Error ? error.message : "Could not create session")
+    } finally { setState("busy", false) }
+  }
+  return <Dialog title="New session">
+    <form class="flex flex-col gap-4 p-6" onSubmit={submit}>
+      <TextField label="Session folder name" value={state.name} onChange={(name) => setState("name", name)} autofocus />
+      <p>Files will be saved in a new folder inside your configured Sessions directory.</p>
+      <Show when={state.error}><p role="alert">{state.error}</p></Show>
+      <Button type="submit" disabled={state.busy}>{state.busy ? "Creating…" : "Create session"}</Button>
+    </form>
+  </Dialog>
+}
