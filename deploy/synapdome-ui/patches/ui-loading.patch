@@ -0,0 +1,24 @@
+import { expect, test } from "bun:test"
+import { summarizeAgents, summarizeProviders } from "../../src/server/ui-summary"
+
+test("UI summary excludes repeated execution data without modifying server agents", () => {
+  const permission = [{ permission: "bash", pattern: "*", action: "ask" }]
+  const agent = { name: "mobile-application", mode: "primary", prompt: "private instruction".repeat(1000), permission, model: { providerID: "deepseek", modelID: "test" } }
+  const [summary] = summarizeAgents([agent])
+  expect(summary).not.toHaveProperty("prompt")
+  expect(summary.permission).toEqual([])
+  expect(summary.name).toBe(agent.name)
+  expect(summary.model).toEqual(agent.model)
+  expect(agent.permission).toBe(permission)
+  expect(agent.prompt).toContain("private instruction")
+  expect(JSON.stringify(summary).length).toBeLessThan(JSON.stringify(agent).length / 10)
+})
+
+test("provider summary preserves connected models and disconnected connection cards", () => {
+  const models = { test: { id: "test", cost: { input: 1 }, limit: { context: 1000 } } }
+  const providers = [{ id: "deepseek", name: "DeepSeek", models }, { id: "other", name: "Other", models }]
+  const result = summarizeProviders(providers, ["deepseek"])
+  expect(result[0]).toBe(providers[0])
+  expect(result[1]).toEqual({ id: "other", name: "Other", models: {} })
+  expect(providers[1].models).toBe(models)
+})
