+/** Browser selectors need metadata, not server-side execution instructions. */
+export function summarizeAgents<T extends { prompt?: string; permission: unknown[] }>(agents: T[]) {
+  return agents.map(({ prompt: _prompt, permission: _permission, ...metadata }) => ({
+    ...metadata,
+    permission: [],
+  }))
+}
+
+/** Keep connection cards for every provider and complete models for connected ones. */
+export function summarizeProviders<T extends { id: string; models: Record<string, unknown> }>(
+  providers: T[],
+  connected: string[],
+) {
+  const ids = new Set(connected)
+  return providers.map((provider) => ids.has(provider.id) ? provider : { ...provider, models: {} })
+}
