# Generate a NEW value on the server; never copy laptop credentials into git.
CYBERSTRIKE_SERVER_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CYBERSTRIKE_SERVER_USERNAME=cyberstrike
# Use the stable remote Mac device through the private SSH tunnel.
ADB_SERVER_SOCKET=tcp:127.0.0.1:15037
# Add installed tools' directories as needed. Frida client must be 17.8.2.
PATH=/opt/synapdome-tools/bin:/usr/local/bin:/usr/bin:/bin

# Operator-controlled artifact root. New sessions receive a named subfolder.
SYNAPDOME_SESSION_ROOT=/home/ubuntu
